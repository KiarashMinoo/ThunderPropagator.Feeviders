<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <PropertyGroup>
        <OutputType>Library</OutputType>
    </PropertyGroup>

    <PropertyGroup Label="PackageId">
        <PackageId Condition="'$(Configuration)' == 'Debug' And '$(Platform)' != 'AnyCPU'">$(RootNameSpace).Debug.$(Platform)</PackageId>
        <PackageId Condition="'$(Configuration)' == 'Debug' And '$(Platform)' == 'AnyCPU'">$(RootNameSpace).Debug</PackageId>
        <PackageId Condition="'$(Configuration)' == 'Release' And '$(Platform)' != 'AnyCPU'">$(RootNameSpace).$(Platform)</PackageId>
        <PackageId Condition="'$(Configuration)' == 'Release' And '$(Platform)' == 'AnyCPU'">$(RootNameSpace)</PackageId>
    </PropertyGroup>

    
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="RapidStreamer.BuildingBlocks.Debug.ARM64" Version="1.0.128-beta.2" Condition="'$(Platform)' == 'ARM64'"/>
        <PackageReference Include="RapidStreamer.BuildingBlocks.Debug.x86" Version="1.0.128-beta.2" Condition="'$(Platform)' == 'x86'"/>
        <PackageReference Include="RapidStreamer.BuildingBlocks.Debug.x64" Version="1.0.128-beta.2" Condition="'$(Platform)' == 'x64'"/>
        <PackageReference Include="RapidStreamer.BuildingBlocks.Debug" Version="1.0.128-beta.2" Condition="'$(Platform)' == 'AnyCPU'"/>
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Release'">
        <PackageReference Include="RapidStreamer.BuildingBlocks.ARM64" Version="1.0.128-beta.2" Condition="'$(Platform)' == 'ARM64'"/>
        <PackageReference Include="RapidStreamer.BuildingBlocks.x86" Version="1.0.128-beta.2" Condition="'$(Platform)' == 'x86'"/>
        <PackageReference Include="RapidStreamer.BuildingBlocks.x64" Version="1.0.128-beta.2" Condition="'$(Platform)' == 'x64'"/>
        <PackageReference Include="RapidStreamer.BuildingBlocks" Version="1.0.128-beta.2" Condition="'$(Platform)' == 'AnyCPU'"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MQTTnet" Version="5.0.1.1416"/>
    </ItemGroup>

</Project>