<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="$(BuildingBlocksPackageId)" Version="1.0.1-beta.124" />
    <PackageVersion Include="$(ThunderPropagatorPackageId)" Version="1.0.1-beta.205" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'" Label="Microsoft.Extensions">
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="8.*" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="8.*" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="8.*" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="8.*" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.*" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="8.*" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="8.*" />
    <PackageVersion Include="Microsoft.AspNetCore.Connections.Abstractions" Version="8.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'" Label="Microsoft.Extensions">
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="9.*" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="9.*" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.*" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="9.*" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="9.*" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="9.*" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="9.*" />
    <PackageVersion Include="Microsoft.AspNetCore.Connections.Abstractions" Version="9.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'" Label="Microsoft.Extensions">
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.*" />
    <PackageVersion Include="Microsoft.AspNetCore.Connections.Abstractions" Version="10.*" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="NodaTime" Version="3.2.2" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.17.0" />
    <PackageVersion Include="Apache.NMS" Version="2.2.0" />
    <PackageVersion Include="Apache.NMS.ActiveMQ" Version="2.2.0" />
    <PackageVersion Include="AWSSDK.SQS" Version="4.0.100.6" />
    <PackageVersion Include="AWSSDK.SimpleNotificationService" Version="4.0.100.7" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.20.2" />
    <PackageVersion Include="Confluent.Kafka" Version="2.15.0" />
    <PackageVersion Include="Confluent.SchemaRegistry" Version="2.15.0" />
    <PackageVersion Include="Confluent.SchemaRegistry.Serdes.Avro" Version="2.15.0" />
    <PackageVersion Include="Confluent.SchemaRegistry.Serdes.Json" Version="2.15.0" />
    <PackageVersion Include="Google.Cloud.PubSub.V1" Version="3.36.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.35.1" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.83.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="MQTTnet" Version="5.2.0.1603" />
    <PackageVersion Include="MQTTnet.Server" Version="5.2.0.1603" />
    <PackageVersion Include="NATS.Net" Version="3.0.1" />
    <PackageVersion Include="NetMQ" Version="4.0.4.3" />
    <PackageVersion Include="DotPulsar" Version="5.3.1" />
    <PackageVersion Include="NJsonSchema" Version="11.6.1" />
    <PackageVersion Include="NJsonSchema.Annotations" Version="11.6.1" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.1" />
    <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageVersion Include="StackExchange.Redis" Version="3.1.31" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Testcontainers" Version="4.13.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
</Project>
